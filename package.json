{
  "name": "crochetbuilder",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "CrochetBuilder monorepo: pattern engine, builder app, viewer",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "start": "npm run dev --workspace @crochetbuilder/builder -- --open",
    "dev": "npm run dev --workspace @crochetbuilder/builder --",
    "build": "npm run build --workspace @crochetbuilder/builder",
    "preview": "npm run preview --workspace @crochetbuilder/builder -- --open",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p e2e",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "typescript": "^5.8.3",
    "vitest": "^4.1.8"
  }
}
